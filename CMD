# SFT1200 手工调试参考
#
# 正式构建推荐使用 GitHub Actions。
# 兼容逻辑只维护在 diy-part1.sh / diy-part2.sh 中，不再在本文件复制一套，
# 避免 NaiveProxy HASH、Go 版本、Passwall 依赖等逻辑长期漂移。

REPO_ROOT=/path/to/Actions-SFT1200

git clone --depth=1 -b main \
  https://github.com/201821143044/gl-infra-builder-new openwrt

cd openwrt
python3 setup.py -c ./configs/config-siflower-18.x.yml
cd openwrt-18.06/siflower/openwrt-18.06

# 注意：
# GitHub Actions 的 Clone source code 步骤还会在 gen_config 前执行一层
# SFT1200 / OpenWrt 18.06 兼容处理。需要完整复现 CI 时，以 workflow 为准。

./scripts/gen_config.py target_siflower_gl-sft1200 luci

cp "$REPO_ROOT/feeds.conf.default" ./feeds.conf.default 2>/dev/null || true
bash "$REPO_ROOT/diy-part1.sh"

./scripts/feeds update -a
./scripts/feeds install -a

cp "$REPO_ROOT/.config" .config
GITHUB_WORKSPACE="$REPO_ROOT" bash "$REPO_ROOT/diy-part2.sh"

make download -j8
make -j"$(nproc)"

# 如需详细错误日志：
# make -j1 V=s
